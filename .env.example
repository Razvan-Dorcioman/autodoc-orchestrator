# Copy to .env and fill in. Never commit .env.

# Gemini API key from AI Studio (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=

# Optional model chains, comma-separated, first choice first. When a model is
# overloaded, rate-limited, timing out or retired, the step moves to the next one.
# AUTODOC_AGENT_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash
# AUTODOC_JUDGE_MODEL=gemini-pro-latest,gemini-3.1-pro-preview,gemini-3.8-flash
