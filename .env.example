# Copy to .env and fill in. Never commit .env.

# Model backend: "local" (default) or "gemini".
# AUTODOC_PROVIDER=local

# --- local: an open-weight model behind an OpenAI-compatible server -------------
# Ollama setup (https://ollama.com), sized for a 16 GB GPU:
#   ollama pull qwen3:14b
#   OLLAMA_CONTEXT_LENGTH=16384 ollama serve     # Ollama's default context is much smaller
# The agents send handler source + facts; a truncated prompt fails silently, so
# keep the context at 16k or more. llama.cpp, LM Studio and vLLM work too: point
# AUTODOC_LOCAL_URL at their /v1 endpoint.
# AUTODOC_LOCAL_URL=http://localhost:11434/v1
# AUTODOC_LOCAL_API_KEY=            # only if the server wants one
# AUTODOC_HTTP_TIMEOUT=10m          # per request; local models load and generate slowly

# --- gemini ----------------------------------------------------------------------
# Gemini API key from AI Studio (https://aistudio.google.com/apikey).
# GOOGLE_API_KEY=

# Optional model chains, comma-separated, first choice first. When a model is
# missing, overloaded, rate-limited or timing out, the step moves to the next one.
# Defaults: local qwen3:14b for both; gemini as in DESIGN.md.
# AUTODOC_AGENT_MODEL=qwen3:14b
# AUTODOC_JUDGE_MODEL=qwen3:14b

# --- delivery ----------------------------------------------------------------------
# A run commits its result on the local branch autodoc/<base sha> in runs/<id>/work.
# With a token, it also pushes that branch to the repository it cloned, which must
# be an https URL (a GitHub or GitLab token with write access to it). Without one,
# nothing leaves the machine.
# AUTODOC_GIT_TOKEN=

# --- limits ------------------------------------------------------------------------
# Tokens the whole run may use, every agent together (0: no limit). Once used up,
# the step that asks for another model call fails: the working copy is reset and
# nothing is committed. Runs on a small service use a few hundred thousand.
# AUTODOC_TOKEN_BUDGET=1000000
